#!/usr/bin/env bash
# The push gate: ./check.sh (package tests + both app builds), which check.sh's
# own header already asks for "before you push". Nothing on GitHub runs it
# automatically any more (POLICY §10, 2026-09-30).
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

# One stdin line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# A deletion has an all-zeros local sha and ships no code; skip only when
# every ref in the push is one.
work=0
while read -r _lref lsha _rref _rsha; do
  case "${lsha:-}" in ''|*[!0]*) [ -n "${lsha:-}" ] && work=1 ;; esac
done
[ "$work" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR to hooks (a worktree's .git/worktrees/<name>). SwiftPM
# runs git inside .build/repositories and inherits it, so every package
# checkout looks for its commits in this repo and fails with "unable to read
# tree". check.sh needs none of these; the cwd is already the top level.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
exec ./check.sh
