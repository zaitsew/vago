{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "comment": "Empty label of a hidden picker in the setup window."
    },
    "%@ %@–%@": {
      "comment": "Short work hours for the setup summary. First argument: the days; then the start and end hours. Example: Mon–Fri 9–18.\nWork hours. First argument: the days; then the start and end clock times. Example: Mon–Fri 09:00–18:00.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@–%3$@"
          }
        }
      }
    },
    "%@ %lldm": {
      "comment": "Menu-bar text during a focus session. First argument: the tree emoji; second: minutes left.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lldm"
          }
        }
      }
    },
    "%@ (block)": {
      "comment": "Settings summary: a guarded place that is blocked in work hours. The argument is the place name."
    },
    "%@ (pause)": {
      "comment": "Settings summary: a guarded place that pauses. The argument is the place name."
    },
    "%@ allowed": {
      "comment": "Settings: a browser the owner allowed Automation for. The argument is the browser name."
    },
    "%@ at risk — back to work?": {
      "comment": "Focus nudge title. The argument is the tree emoji of the running focus session."
    },
    "%@ at the Mac · %@": {
      "comment": "Popover move row. First argument: a duration; second: the moves-today phrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at the Mac · %2$@"
          }
        }
      }
    },
    "%@ counts as waste": {
      "comment": "Drift notice subtitle, variant B. The argument is the place name."
    },
    "%@ denied": {
      "comment": "Settings: a browser the owner denied Automation for. The argument is the browser name."
    },
    "%@ is blocked": {
      "comment": "Block card title when no end time is known. The argument is the place name."
    },
    "%@ is blocked until %@": {
      "comment": "Block card title. First argument: the place name; second: the clock time the work hours end, such as 18:00.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is blocked until %2$@"
          }
        }
      }
    },
    "%@ neutral": {
      "comment": "Hour tooltip: neutral time in that hour. The argument is a duration."
    },
    "%@ waste": {
      "comment": "Hour tooltip: waste time in that hour. The argument is a duration."
    },
    "%@ work": {
      "comment": "Hour tooltip: work time in that hour. The argument is a duration."
    },
    "%@ work · %@ neutral · %@ waste": {
      "comment": "The day split under the share. Each argument is a duration such as 3h 12m.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ work · %2$@ neutral · %3$@ waste"
          }
        }
      }
    },
    "%@ · %lld min a day · %@": {
      "comment": "Settings summary of the guard. First argument: the places; second: the daily budget in minutes; third: the work hours.\nSetup summary bar. First argument: a phrase such as 3 places; second: the daily budget in minutes; third: the work hours.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld min a day · %3$@"
          }
        }
      }
    },
    "%@: most waste at %lld:00": {
      "comment": "Accessibility summary of one day-strip lane. First argument: the device name; second: the hour of the day with the most waste.",
      "localizations": {
